    "    fig , ax = plt.subplots(ncols=2 ,figsize=(12, 4))\n",
    "    \n",
    "    ax[0].hist(column, bins=30)\n",
    "    ax[0].set_title('Histogram')\n",
    "    ax[0].set_xlabel(column.name)\n",
    "    ax[0].set_ylabel('Frequency')\n",
    "\n",
    "    # Box plot\n",
    "    ax[1].boxplot(column)\n",
    "    ax[1].set_title('Box Plot')\n",
    "    ax[1].set_ylabel(column.name)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    "
   ]
